<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
<key>CFBundleIdentifier</key><string>org.outrun.mac.game</string>
<key>CFBundleName</key><string>OutRun2006</string>
<key>CFBundleDisplayName</key><string>OutRun2006 Coast 2 Coast</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleIconFile</key><string>OutRun</string>
<key>CFBundleVersion</key><string>${OR2_BUILD_NUMBER}</string>
<key>CFBundleShortVersionString</key><string>${OR2_APP_VERSION}</string>
<key>LSMinimumSystemVersion</key><string>14.0</string>
<key>LSApplicationCategoryType</key><string>public.app-category.racing-games</string>
<!-- Game Mode (iOS 18 / macOS 14): also implied by the game category, declared outright. -->
<key>GCSupportsGameMode</key><true/>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
